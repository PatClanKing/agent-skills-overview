@startuml flow-agent
!include _style.iuml
hide footbox
title Example 2: an agent hands work to a subagent that uses skills

actor "User" as U
participant "<:robot:> Main agent" as M
participant "<:robot:> release-checker\n(subagent)" as A
collections "<:file_folder:> .claude/skills/" as S

U -> M : "get the 1.3 release ready"
activate M
M -> A : delegate: "check and write\nnotes for 1.3" (Agent tool)
activate A
S -> A : skills: [release-notes]\npreloaded in full at start
note over A : fresh context: no chat\nhistory, only the task
A -> A : follow release-notes steps,\nrun check.py until PASS
A -> S : changelog skill matches:\nload it (Skill tool)
S --> A : changelog instructions
A --> M : short summary + file paths
deactivate A
M --> U : "1.3 is ready, notes in NOTES.md"
deactivate M
@enduml
